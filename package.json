{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @repo/logger build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @repo/logger build && pnpm -r typecheck"
  },
  "devDependencies": { "typescript": "^7.0.2" }
}
